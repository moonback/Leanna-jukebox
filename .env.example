# Copier ce fichier en .env.local et renseigner les valeurs (Supabase > Project Settings > API).
# Seule la clé "anon" (publique) doit être utilisée ici, jamais la clé service_role.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# Recherche YouTube dans l'espace parent (Google Cloud > API YouTube Data v3 > Identifiants > Clé API).
# Restreindre la clé à « YouTube Data API v3 ». Sans clé, l'ajout par lien YouTube reste disponible.
VITE_YOUTUBE_API_KEY=votre-cle-api-youtube
